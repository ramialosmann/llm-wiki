#!/usr/bin/env node
// wiki-lint <wiki-root> [name=path …] [--diet] — the mechanical half of /wiki lint (Node port of v1 wiki-lint.py).
//
// Reports broken wikilinks, pages missing from index.md, orphans, and code pages whose `verified: repo@sha` is
// behind changes to the paths they cite (`repo:path` refs and `paths:` globs). Links resolve like Obsidian:
// basename, path suffix, or frontmatter alias. Generated pages (`generated: true`, code/) are exempt.
// --diet adds a report-only content check: dated headings, pages over 6 KB, code blocks over 15 lines,
// missing `summary:`. Exit 1 if anything is found.
'use strict';
const fs = require('fs');
const path = require('path');
const { execFileSync } = require('child_process');
const { listPages, frontmatter } = require('../lib/wiki');

const args = process.argv.slice(2);
const diet = args.includes('--diet');
const root = path.resolve(args.find((a) => !a.startsWith('--') && !a.includes('=')) || '.');
const repos = Object.fromEntries(args.filter((a) => a.includes('=') && !a.startsWith('--')).map((a) => [a.slice(0, a.indexOf('=')), a.slice(a.indexOf('=') + 1)]));
const LINK = /\[\[([^\]|#]+)(?:#[^\]|]*)?(?:\|[^\]]*)?\]\]/g;
const FENCE = /```[\s\S]*?```|`[^`\n]*`/g;

const pages = new Map();
for (const p of listPages(root)) {
  const text = fs.readFileSync(path.join(root, p), 'utf8');
  pages.set(p.slice(0, -3), { text, fm: frontmatter(text) });
}
const generated = (rel) => rel.startsWith('code/') || pages.get(rel).fm.data.generated === 'true';

const names = new Map();
const add = (k, rel) => { if (!names.has(k)) names.set(k, rel); };
for (const [rel, { fm }] of pages) {
  add(path.basename(rel).toLowerCase(), rel);
  add(rel.toLowerCase(), rel);
  for (const a of [].concat(fm.data.aliases || [])) if (a) add(String(a).toLowerCase(), rel);
}
const resolve = (t) => {
  t = t.trim().toLowerCase().replace(/\.md$/, '');
  if (names.has(t)) return names.get(t);
  for (const [k, rel] of names) if (k.endsWith('/' + t)) return rel;
  return null;
};

const broken = [], inbound = new Map([...pages.keys()].map((k) => [k, 0]));
for (const [rel, { text }] of pages) {
  for (const m of text.replace(FENCE, '').matchAll(LINK)) {
    const hit = resolve(m[1]);
    if (!hit) broken.push(`${rel} | ${m[1]}`);
    else if (hit !== rel) inbound.set(hit, inbound.get(hit) + 1);
  }
}
const exempt = (r) => ['index', 'log', 'CLAUDE'].includes(r) || generated(r);
const indexed = new Set([...((pages.get('index') || {}).text || '').matchAll(LINK)].map((m) => resolve(m[1])));
const missing = [...pages.keys()].filter((r) => !indexed.has(r) && !exempt(r)).sort();
const orphans = [...inbound].filter(([r, n]) => !n && !exempt(r)).map(([r]) => r).sort();

const stale = [];
for (const [rel, { text, fm }] of pages) {
  const v = /^(\w[\w-]*)@([0-9a-f]{7,40})$/.exec(String(fm.data.verified || ''));
  if (!v || !repos[v[1]] || generated(rel)) continue;
  const cites = [...text.matchAll(new RegExp(`\\b${v[1]}:([\\w./\\[\\]()-]+)`, 'g'))].map((m) => m[1].replace(/[.)]+$/, ''));
  const globs = [].concat(fm.data.paths || []).filter(Boolean).map((g) => `:(glob)${String(g).replace(new RegExp(`^${v[1]}:`), '')}`);
  if (!cites.length && !globs.length) continue;
  let out = '';
  try {
    out = execFileSync('git', ['-C', repos[v[1]], 'log', '--oneline', `${v[2]}..HEAD`, '--', ...new Set(cites), ...globs],
                       { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }).trim();
  } catch { /* unknown sha or path */ }
  if (out) stale.push(`${rel} | ${v[0]} | ${out.split('\n').length}`);
}

const sections = [['Broken wikilinks (page | target)', broken], ['Not in index.md', missing],
  ['Orphans (no inbound links)', orphans], ['Stale verified (page | sha | commits since, on cited paths)', stale]];
if (diet) {
  const dated = [], big = [], blocks = [], nosum = [];
  for (const [rel, { text, fm }] of pages) {
    if (exempt(rel) || /^(raw|discussions|sources)\//.test(rel)) continue;
    for (const m of fm.body.matchAll(/^#{2,4} .*\b\d{4}-\d{2}-\d{2}\b.*$/gm)) dated.push(`${rel} | ${m[0].trim()}`);
    if (Buffer.byteLength(text) > 6144) big.push(`${rel} | ${(Buffer.byteLength(text) / 1024).toFixed(1)} KB`);
    for (const m of fm.body.matchAll(/```[\s\S]*?```/g)) if (m[0].split('\n').length > 17) blocks.push(`${rel} | ${m[0].split('\n').length - 2} lines`);
    if (!fm.data.summary && fm.data.type !== 'state') nosum.push(rel);
  }
  sections.push(['Diet: dated headings (rewrite in place)', dated], ['Diet: pages over 6 KB (split by topic)', big],
    ['Diet: code blocks over 15 lines (point at the file)', blocks], ['Diet: missing summary: (wiki-index --backfill)', nosum]);
}
for (const [title, rows] of sections) {
  console.log(`## ${title}: ${rows.length}`);
  for (const r of rows) console.log('- ' + r);
}
process.exit(sections.some(([, rows]) => rows.length) ? 1 : 0);
